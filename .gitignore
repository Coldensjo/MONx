node_modules
dist
src-tauri/target
src-tauri/gen/schemas

# Per-agent git worktrees, and each machine's own Claude Code settings.
.claude/worktrees/
.claude/settings.local.json

# Probe output: `probe_dat`/`probe_assets` write their PNGs next to wherever
# they are run from, which is usually src-tauri/. The app's own icons live in
# src-tauri/icons/ and are committed.
src-tauri/*.png

# The fixture workspace: a real server's monster/item data and a full Tibia
# client (Tibia.spr alone is 54 MB). Needed on disk to run and verify MONx —
# see AGENTS.md — but deliberately never committed.
assets/
sources/
# Reference client sources, dropped in alongside `sources/` for the same reason:
# needed on disk to read a format, never ours to commit.
clients/

# Working notes, kept local. ENGINES.md is *not* here — README, AGENTS.md and
# CONTRIBUTING.md all link it, so it has to be in the repo the links are in.
/BUGS.md
/MISMATCHES.md
/SHORTCUTS.md