		<immunity energy="0" />
		<immunity poison="1" />
		<immunity physical="0" />
		<immunity outfit="0" />
		<immunity lifedrain="0" />
		<immunity paralyze="1" />
		<immunity invisible="0" />
	</immunities>
	<voices>
		<voice sentence="Stand and deliver!" />
		<voice sentence="You will not pass." />
	</voices>
	<loot>
		<item id="2148" countmax="10" chance="40000" /><!-- gold coin -->
		<item id="2379" countmax="1" chance="80000" /><!-- dagger -->
	</loot>
</monster>
